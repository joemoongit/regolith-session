#!/bin/sh
# regolith-multisession: entries, the primary/standalone decision, the
# Xsession hook, the component and autostart planner, the shims, and two
# standalone sessions with i3 on Xvfb (private buses, bridged dconf, session
# manager, logout, teardown). See multisession.bash.
set -eu
here=$(dirname "$0")
# A session component that only exists as a systemd user unit, as the gsd
# plugins do on Ubuntu 26.04
mkdir -p /usr/local/lib/systemd/user
printf '[Service]\nExecStart=-/usr/libexec/comp-unit --flag %%h\n' \
    > /usr/local/lib/systemd/user/comp-unit.service
# ... and a service that only the session's systemd target pulls in, as
# regolith-session-flashback's drop-in does for the GNOME Flashback polkit agent
printf '[Service]\nExecStart=/usr/libexec/target-svc\n' > /usr/local/lib/systemd/user/target-svc.service
mkdir -p /usr/local/lib/systemd/user/gnome-session@testde.target.d
printf '[Unit]\nWants=org.example.Some.target\nWants=target-svc.service comp-unit.service\nRequires=testde-wm.service\n' \
    > /usr/local/lib/systemd/user/gnome-session@testde.target.d/session.conf
trap 'rm -rf /usr/local/lib/systemd/user/comp-unit.service /usr/local/lib/systemd/user/target-svc.service \
    /usr/local/lib/systemd/user/gnome-session@testde.target.d' EXIT
"$here/multisession-as-user" "$here/multisession.bash"

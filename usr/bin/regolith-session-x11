#!/bin/bash
# This script initializes Regolith Xresources and launches i3.

set -Eeu -o pipefail

source /usr/lib/regolith/regolith-session-common.sh

# An additional session for a user whose first session is already running
# runs standalone: directly by regolith-session-x11-launch, which sets
# REGOLITH_X11_STANDALONE, or, when this script is reached without it,
# by noticing the first session here. The systemd session (NOTIFY_SOCKET
# is set) and a gnome-session that runs this script itself
# (DESKTOP_AUTOSTART_ID is set) are the first session, never an addition.
if [ -z "${REGOLITH_X11_STANDALONE-}" ] \
   && [ -z "${NOTIFY_SOCKET-}" ] \
   && [ -z "${DESKTOP_AUTOSTART_ID-}" ] \
   && regolith_x11_primary_session_active; then
    export REGOLITH_X11_STANDALONE=1
fi

gdm3_xrdb_fixup() {
    if xrescat testkey defaultval > /dev/null 2>&1; then
        echo "xrdb appears to be property initialized, skipping xrdb init"
    else # TODO(kgilmer) ~ consider further predication upon distro/codename if reason to believe following codeblock might cause harm
        echo "xrdb appears to not be running. Manually initializing.."

        load_system_xres
    fi
}
# Check if NOTIFY_SOCKET is available. This is used as a
# test to see if the session uses systemd
if [ -z "${NOTIFY_SOCKET-}" ]; then
  # Register with gnome-session so that it does not kill the whole session thinking it is dead.
  # When gnome-session respawns us after i3 crashed, the client is still
  # registered and this fails with AlreadyRegistered; i3 must start anyway.
  # An additional session has no gnome-session of its own: the session bus
  # name belongs to the first session's manager, so it must not register
  # there either.
  if [ -z "${REGOLITH_X11_STANDALONE-}" ] && [ -n "${DESKTOP_AUTOSTART_ID-}" ]; then
      dbus-send --print-reply --session --dest=org.gnome.SessionManager "/org/gnome/SessionManager" org.gnome.SessionManager.RegisterClient "string:Regolith-X11" "string:$DESKTOP_AUTOSTART_ID" \
          || echo "Could not register with gnome-session, continuing"
  fi

  # Add the environment.d variables the login environment does not set
  import_environment_d
fi

# --------- Script Main -----------
clear_wm_sockets    # SWAYSOCK and I3SOCK of an earlier session

gdm3_xrdb_fixup     # Remove when https://bugs.launchpad.net/ubuntu/+source/gdm3/+bug/1955850 is fixed
load_i3_resources   # ~/.Xresources, ~/.config/regolith3/Xresources and the look, as 'regolith-look refresh' does

if [ -n "${REGOLITH_X11_STANDALONE-}" ]; then
    # The usual logout program, gnome-session-quit, talks to the first
    # session's manager on the shared session bus and would log that
    # session out instead of this one. Exit only this session's i3: it is
    # found through this display, not through an I3SOCK inherited from
    # another session, and when it exits this script returns and LightDM
    # ends only this session. Merged after the resources above, this wins
    # over the look's and the user's wm.program.logout for this display
    # only; the first session's resources are on its own display.
    printf '%s\n' 'wm.program.logout: env -u I3SOCK i3-msg exit' \
        | xrdb -nocpp -merge \
        || echo "Could not set the additional session's logout program, continuing"
fi

UPDATE_FLAG_DIR="$HOME/.config/regolith3/flags"
if [ ! -e "$UPDATE_FLAG_DIR" ]; then
    # flag file has not been created, meaning this is first session load
    # in this case, we need to configure some desktop settings from the look
    LOADER_PATH="$($RESOURCE_GETTER regolith.look.loader)"
    if [ -n  "$LOADER_PATH" ]; then
        # Load the look-specific script that has a function called load_look()
        source "$LOADER_PATH"
        # Call look function to update UI
        load_look
        # Apply the look only once: later logins keep the user's settings,
        # 'regolith-look refresh' or 'regolith-look set' apply it again
        mkdir -p "$UPDATE_FLAG_DIR"
    fi
fi

resolve_default_config_file
echo "Regolith is launching i3 with $I3_CONFIG_FILE"
i3 -c "$I3_CONFIG_FILE"

# Run the user's post-logout script. In a systemd-managed session,
# regolith-post-logout.service runs it when the session ends: logging out
# stops this script together with the window manager, so it would never get
# here. Without systemd (gnome-session --builtin) it runs here.
if [ -z "${NOTIFY_SOCKET-}" ] && [ -f "$USER_POST_LOGOUT_SCRIPT_FILE" ] ; then
    echo "Regolith is launching user post-logout file $USER_POST_LOGOUT_SCRIPT_FILE"
	timeout --verbose 5 bash "$USER_POST_LOGOUT_SCRIPT_FILE"
fi

#!/bin/bash
set -Eeu -o pipefail

SESSION_TYPE="regolith-x11"

# /etc/X11/Xsession.d/19regolith-session-x11 puts a
# dbus-update-activation-environment that does nothing first in PATH if
# another Regolith X11 session runs; take it out again
xsession_bin=/usr/lib/regolith/xsession
held_environment=
case ":$PATH:" in
    *":$xsession_bin:"*)
        PATH=":$PATH:"
        PATH=${PATH//":$xsession_bin:"/:}
        PATH=${PATH#:}
        export PATH=${PATH%:}
        held_environment=1
        ;;
esac

if [ -z "${XDG_CURRENT_DESKTOP-}" ]; then
    export XDG_CURRENT_DESKTOP="Regolith:GNOME-Flashback:GNOME"
fi

# Session-scoped XDG configuration, such as the autostart entries hidden in
# this session, lives in /etc/xdg/xdg-$SESSION_TYPE. Ubuntu's Xsession and
# profile scripts put it first in XDG_CONFIG_DIRS; do the same where they
# don't run (Debian, other display managers) so gnome-session sees it.
case ":${XDG_CONFIG_DIRS-}:" in
    *":/etc/xdg/xdg-$SESSION_TYPE:"*) ;;
    *) export XDG_CONFIG_DIRS="/etc/xdg/xdg-$SESSION_TYPE:${XDG_CONFIG_DIRS:-/etc/xdg}" ;;
esac

if [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    source /etc/os-release

    if [[ "${VERSION_CODENAME-}" == "jammy" || "${VERSION_CODENAME-}" == "bookworm" ]]; then
        exec gnome-session --builtin --session=$SESSION_TYPE --disable-acceleration-check "$@"
    fi
fi

# gnome-session runs one session per user, see regolith-session-x11-state.sh:
# a second login of the same user would end at once and the display manager
# would show the greeter again.
# shellcheck source=../lib/regolith/regolith-session-x11-state.sh
source /usr/lib/regolith/regolith-session-x11-state.sh
start_nested_session() {
    # Run this session in a systemd user instance of its own, see
    # regolith-session-nested
    exec /usr/lib/regolith/regolith-session-nested $SESSION_TYPE --disable-acceleration-check "$@"
}
if regolith_session_target_active; then
    if regolith_session_leader_running; then
        echo "A Regolith X11 session is already running for ${USER:-$(id -un)}, starting another one" >&2
        start_nested_session "$@"
    fi
    # The session ended, but its targets are still active, for example because
    # its leader was killed before it could stop them; gnome-session would
    # refuse to start until they are stopped
    echo "Stopping what is left of an earlier session" >&2
    if ! regolith_session_stop_stale; then
        echo "Could not stop the earlier session, starting another one" >&2
        start_nested_session "$@"
    fi
fi

# If the other session ended meanwhile, hand this login's environment to the
# user's systemd instance and D-Bus session bus as the Xsession.d scripts
# would have
if [ -n "$held_environment" ]; then
    (
        unset XDG_SEAT XDG_SEAT_PATH XDG_SESSION_ID XDG_SESSION_PATH XDG_VTNR
        dbus-update-activation-environment --systemd --all
    )
fi

exec gnome-session --session=$SESSION_TYPE --disable-acceleration-check "$@"

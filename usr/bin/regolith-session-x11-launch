#!/bin/bash
set -Eeu -o pipefail

SESSION_TYPE="regolith-x11"

if [ -z "${XDG_CURRENT_DESKTOP-}" ]; then
    export XDG_CURRENT_DESKTOP="Regolith:GNOME-Flashback:GNOME"
fi

# Session-scoped XDG configuration, such as the autostart entries hidden in
# this session, lives in /etc/xdg/xdg-$SESSION_TYPE. Ubuntu's Xsession and
# profile scripts put it first in XDG_CONFIG_DIRS; do the same where they
# don't run (Debian, other display managers) so gnome-session sees it.
case ":${XDG_CONFIG_DIRS-}:" in
    *":/etc/xdg/xdg-$SESSION_TYPE:"*) ;;
    *) export XDG_CONFIG_DIRS="/etc/xdg/xdg-$SESSION_TYPE:${XDG_CONFIG_DIRS:-/etc/xdg}" ;;
esac

# The systemd user manager, and the gnome-session instance it runs, are
# singletons for a user: a second gnome-session for the same user cannot
# start while the first session runs, and starting one would replace the
# first session's DISPLAY, XAUTHORITY and I3SOCK in the user manager.
# Further logins therefore run i3 directly on their own display, without
# gnome-session or the user manager's session units. This is per-user
# (systemctl --user only sees this user's manager), has no count limit,
# and leaves other users' managers untouched.
primary_session_active() {
    systemctl --user is-active --quiet regolith-x11.service 2>/dev/null && return 0
    systemctl --user is-active --quiet regolith-x11.target 2>/dev/null && return 0
    systemctl --user is-active --quiet "gnome-session@$SESSION_TYPE.target" 2>/dev/null && return 0
    systemctl --user is-active --quiet "gnome-session-manager@$SESSION_TYPE.service" 2>/dev/null && return 0
    systemctl --user is-active --quiet gnome-session-manager.target 2>/dev/null && return 0
    systemctl --user is-active --quiet gnome-session.target 2>/dev/null && return 0
    systemctl --user is-active --quiet graphical-session.target 2>/dev/null && return 0
    unit_active_or_starting regolith-x11.service && return 0
    unit_active_or_starting "gnome-session-manager@$SESSION_TYPE.service" && return 0
    # Only live state counts here: the user manager's environment is not
    # proof, as it can hold a finished session's stale values.
    other_display_session_active && return 0
    return 1
}

unit_active_or_starting() { # unit_active_or_starting <unit>
    local state
    state=$(systemctl --user show --property=ActiveState --value "$1" 2>/dev/null \
            | head -n 1) || state=
    case "$state" in
        active|activating|reloading|deactivating) return 0 ;;
        *) return 1 ;;
    esac
}

# Live fallback for sessions the units above do not describe (for example
# a gnome-session --builtin session): another i3 or gnome-session owned
# by this user on a different display. Stale environment alone is not
# used, so a login after every session has ended still takes the normal
# gnome-session path below.
other_display_session_active() {
    local pid proc_display proc_home cmd uid
    [ -n "${DISPLAY-}" ] || return 1
    uid=$(id -u)
    for pid in /proc/[0-9]*; do
        pid=${pid#/proc/}
        [ "$pid" = "$$" ] && continue
        [ "$(stat -c %u "/proc/$pid" 2>/dev/null)" = "$uid" ] || continue
        proc_home=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null \
                    | sed -n 's/^HOME=//p' | head -n 1) || proc_home=
        [ -z "$proc_home" ] || [ "$proc_home" = "${HOME-}" ] || continue
        cmd=$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null) || continue
        case " $cmd " in
            *" i3 "*|*"/i3 "*|\
            *" gnome-session "*|*"/gnome-session "*|\
            *"/gnome-session-service "*) ;;
            *) continue ;;
        esac
        proc_display=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null \
                       | sed -n 's/^DISPLAY=//p' | head -n 1) || proc_display=
        [ -n "$proc_display" ] && [ "$proc_display" != "$DISPLAY" ] && return 0
    done
    return 1
}

if primary_session_active; then
    export REGOLITH_X11_ADDITIONAL_SESSION=1
    # NOTIFY_SOCKET and DESKTOP_AUTOSTART_ID belong to a session leader or
    # gnome-session client, not to this login; the additional session is
    # not a systemd service and must not register with the first session's
    # gnome-session.
    unset NOTIFY_SOCKET DESKTOP_AUTOSTART_ID
    exec regolith-session-x11
fi

if [ -f /etc/os-release ]; then
    # shellcheck disable=SC1091
    source /etc/os-release

    if [[ "${VERSION_CODENAME-}" == "jammy" || "${VERSION_CODENAME-}" == "bookworm" ]]; then
        exec gnome-session --builtin --session=$SESSION_TYPE --disable-acceleration-check "$@"
    fi
fi

exec gnome-session --session=$SESSION_TYPE --disable-acceleration-check "$@"

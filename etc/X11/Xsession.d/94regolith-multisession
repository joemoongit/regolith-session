# regolith-multisession: decide whether this login runs standalone before
# 95dbus_update-activation-env runs. A standalone session must not push its
# DISPLAY into the systemd user manager that the user's first session owns:
# hiding the user bus address skips that script. 'regolith-multisession
# launch' then starts the session on its own bus. Sourced by /etc/X11/Xsession.
case "${DESKTOP_SESSION:-}" in
    *-multisession)
        if [ -x /usr/bin/regolith-multisession ]; then
            if /usr/bin/regolith-multisession should-isolate; then
                MULTISESSION_ISOLATE=1
                unset DBUS_SESSION_BUS_ADDRESS
            else
                MULTISESSION_ISOLATE=0
            fi
            export MULTISESSION_ISOLATE
        fi
        ;;
esac
